downloads/

# =============================
# Python Project .gitignore
# =============================
# This file tells Git which files and folders to ignore in your project.
# Comments below explain each section for beginners.

# Byte-compiled / optimized / DLL files (Python cache)
__pycache__/
*.py[cod]
*$py.class

# C extensions (compiled modules)
*.so

# Distribution / packaging (build artifacts)
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller (for building .exe files)
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff (web framework)
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff (web framework)
instance/
.webassets-cache

# Scrapy stuff (web scraping)
.scrapy

# Sphinx documentation (docs build output)
docs/_build/

# PyBuilder (build tool)
target/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IPython settings
profile_default/
ipython_config.py

# pyenv (Python version manager)
.python-version

# pipenv (virtual environment manager)
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery stuff (task queue)
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Python virtual environments (ignore all common venv folders)
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.envrc
.env.local
.env.development
.env.production
.env.test
/.env
/.venv

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation (site build output)
/site

# mypy (static type checker)
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Configuration files (ignore config.yaml, which is user-specific)
config.yaml